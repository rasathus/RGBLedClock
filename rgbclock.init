#!/bin/sh
### BEGIN INIT INFO
# Provides:          rgbclock
# Required-Start:    $local_fs $remote_fs $time
# Required-Stop:     $local_fs $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Raspberry Pi RGB LED clock
# Description:       Drives a 12 LED RGB clock over SPI.
### END INIT INFO
# /etc/init.d/rgbclock

clock_path='/opt/rgbclock'
startup_args='--type lpd6803'
pidfile='/var/run/rgbclock.pid'

is_running() {
    [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null
}

do_start() {
    echo "Starting Clock ..."
    if is_running; then
        echo "Clock already running"
        return 0
    fi
    # shellcheck disable=SC2086
    /usr/bin/python3 "${clock_path}/clock.py" ${startup_args} > /dev/null 2>&1 &
    echo $! > "$pidfile"
}

do_stop() {
    echo "Stopping Clock ..."
    if is_running; then
        kill -TERM "$(cat "$pidfile")"
    fi
    rm -f "$pidfile"
}

do_status() {
    if is_running; then
        echo "Clock is running (pid $(cat "$pidfile"))"
    else
        echo "Clock is not running"
        return 3
    fi
}

case "$1" in
  start)
    do_start
    ;;
  stop)
    do_stop
    ;;
  restart)
    echo "Restarting Clock ..."
    do_stop
    sleep 1
    do_start
    ;;
  status)
    do_status
    exit $?
    ;;
  *)
    echo "Usage: /etc/init.d/rgbclock {start|stop|restart|status}"
    exit 1
    ;;
esac

exit 0
